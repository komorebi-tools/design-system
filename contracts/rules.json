[
  {
    "id": "NO_EMOJI",
    "severity": "error",
    "description": "絵文字禁止。Material Icons を使う。肌の色の修飾子 (U+1F3FB-U+1F3FF) も検出対象。異体字セレクタ (U+FE0F) 単体は検出しない (直前の絵文字本体で検出されるため)。著作権表記の \u00A9 \u00AE \u2122 は除外",
    "detector": "regex",
    "pattern": "(?![\\u00A9\\u00AE\\u2122])[\\p{Extended_Pictographic}\\u{1F3FB}-\\u{1F3FF}]",
    "alternative": "<span class=\"material-icons\">icon_name</span>"
  },
  {
    "id": "NO_TEXT_BLACK",
    "severity": "error",
    "description": "#000000 禁止。#333333 を使う",
    "detector": "regex",
    "pattern": "#000000|#000;|color:\\s*black[^-]",
    "alternative": "#333333 または var(--text)"
  },
  {
    "id": "NO_FULLWIDTH_SLASH",
    "severity": "warning",
    "description": "全角スラッシュ禁止。半角 + 前後スペース",
    "detector": "regex",
    "pattern": "／",
    "alternative": " / "
  },
  {
    "id": "NO_FULLWIDTH_PAREN",
    "severity": "warning",
    "description": "全角括弧禁止。半角 () にする (外側に半角スペース、内側はスペースなし)",
    "detector": "regex",
    "pattern": "[（）]",
    "alternative": "半角 () にする。外側に半角スペース、内側はスペースなし"
  },
  {
    "id": "NO_PAREN_INNER_SPACE",
    "severity": "warning",
    "description": "半角丸括弧の内側にスペースを入れない (DESIGN.md §3.6 規則4)。括弧の中に日本語 (漢字・ひらがな・カタカナ) があるときだけ検出する。コードの括弧は対象外",
    "detector": "regex",
    "pattern": "\\([ \\t\\u3000]+[^()\\n]*[\\p{Script=Han}\\p{Script=Hiragana}\\p{Script=Katakana}][^()\\n]*\\)|\\([^()\\n]*[\\p{Script=Han}\\p{Script=Hiragana}\\p{Script=Katakana}][^()\\n]*[ \\t\\u3000]+\\)",
    "alternative": "(テキスト) : 外側に半角スペース、内側はスペースなし"
  },
  {
    "id": "NO_FULLWIDTH_COLON",
    "severity": "warning",
    "description": "全角コロン禁止。半角 + 前後スペース",
    "detector": "regex",
    "pattern": "：",
    "alternative": " : "
  },
  {
    "id": "NO_HALFWIDTH_NAKAGURO",
    "severity": "warning",
    "description": "中黒は全角 U+30FB を使う。半角 U+FF65 と中点 U+00B7 は使わない。スライドの中に直接打つ文字だけは半角 (SLIDE.md §5.1) なので、その行は allow 注釈で黙らせる",
    "detector": "regex",
    "pattern": "[\\uFF65\\u00B7]",
    "alternative": "全角中黒「・」(U+30FB)"
  },
  {
    "id": "NO_NAKAGURO_SPACE",
    "severity": "warning",
    "description": "中黒の前後にスペースを入れない (全角 U+30FB・半角 U+FF65・中点 U+00B7 のどれでも)",
    "detector": "regex",
    "pattern": "[ \\t\\u3000][\\u30FB\\uFF65\\u00B7]|[\\u30FB\\uFF65\\u00B7][ \\t\\u3000]",
    "alternative": "A・B (前後スペースなし)"
  },
  {
    "id": "NO_BORDER_RADIUS_50",
    "severity": "warning",
    "description": "border-radius: 50% 禁止。6-8px で統一",
    "detector": "regex",
    "pattern": "border-radius:\\s*50%",
    "alternative": "border-radius: 6px or 8px"
  },
  {
    "id": "NO_HARDCODED_PRIMARY",
    "severity": "warning",
    "description": "Primary カラー直書き禁止。CSS variable を使う",
    "detector": "regex",
    "pattern": "#6[Ee]87[Bb]6",
    "alternative": "var(--primary)"
  }
]
